/*
 * pymolx dark theme (parity item L-01), measured from Incentive PyMOL 3.1:
 * neutral greys, 1px dividers between items, purple accent.
 * "$$name" tokens are colors from modules/pymolx/gui/theme.py,
 * "$$icons" is the pymolx icon directory
 */

QMainWindow, QDialog, QDockWidget
{
    background:     $window;
    color:          $text;
}

QMainWindow::separator
{
    background:     $window;
}

/* menus */

QMenuBar
{
    background:     $window;
    color:          $text;
    border-bottom:  1px solid $border;
    font-size:      13px;
    padding:        1px 2px;
}

QMenuBar::item
{
    padding:        3px 4px;
    background:     transparent;
}

QMenuBar::item:selected, QMenuBar::item:pressed
{
    background:     $hover;
}

QMenu
{
    background:     $menu;
    color:          $text;
    border:         1px solid $border;
    padding:        4px 0px;
    font-size:      13px;
}

QMenu::item
{
    padding:        4px 24px 4px 20px;
}

QMenu::item:selected
{
    background:     $selection;
}

QMenu::item:disabled
{
    color:          $text_dim;
}

/* menus from pymol.menu: menus.PyMenu draws the (colored) item text */
QMenu#pymol_menu::item,
QMenu#pymol_menu::item:selected,
QMenu#pymol_menu::item:disabled
{
    color:          transparent;
}

QMenu::separator
{
    height:         1px;
    background:     $border;
    margin:         4px 8px;
}

/* toolbar: flat full-height buttons separated by 1px dividers */

QToolBar#pymolx_toolbar
{
    background:     $window;
    border:         none;
    border-bottom:  1px solid $border;
    padding:        0px;
    spacing:        0px;
}

QToolBar#pymolx_toolbar::separator
{
    background:     $border;
    width:          1px;
    margin:         0px;
}

QToolBar#pymolx_toolbar QToolButton
{
    color:          $text;
    background:     transparent;
    border:         none;
    border-radius:  0px;
    padding:        0px 10px;
    min-height:     33px;
    font-size:      12px;
    font-weight:    bold;
}

QToolBar#pymolx_toolbar QToolButton:hover
{
    background:     $hover;
}

QToolBar#pymolx_toolbar QToolButton:pressed,
QToolBar#pymolx_toolbar QToolButton:checked
{
    background:     $base;
    color:          $accent_text;
}

QToolBar#pymolx_toolbar QToolButton[accent=true]
{
    color:          $accent_text;
}

/* dropdown (InstantPopup) and split (MenuButtonPopup) buttons */

QToolBar#pymolx_toolbar QToolButton[dropdown=true]
{
    padding-right:  20px;
}

QToolBar#pymolx_toolbar QToolButton::menu-indicator
{
    image:          url($icons/chevron-down.svg);
    width:          10px;
    height:         10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right:          6px;
}

QToolBar#pymolx_toolbar QToolButton[accent=true]::menu-indicator
{
    image:          url($icons/chevron-down-accent.svg);
}

QToolBar#pymolx_toolbar QToolButton[indicator=false]::menu-indicator
{
    image:          none;
    width:          0px;
}

QToolBar#pymolx_toolbar QToolButton[indicator=false]
{
    padding-right:  10px;
}

QToolBar#pymolx_toolbar QToolButton::menu-button
{
    border:         none;
    background:     transparent;
    width:          18px;
}

QToolBar#pymolx_toolbar QToolButton::menu-arrow
{
    image:          url($icons/chevron-down.svg);
    width:          10px;
    height:         10px;
}

QToolBar#pymolx_toolbar QToolButton#more_button
{
    font-size:      15px;
    padding:        0px 10px;
}

/* content panel (object rows) */

QWidget#content_panel, QScrollArea#panel_scroll, QWidget#panel_rows
{
    background:     $window;
    border:         none;
}

QWidget#content_panel
{
    border-left:    1px solid $border;
}

QFrame#panel_row
{
    border-bottom:  1px solid $border;
}

QFrame#panel_row:hover
{
    background:     $hover;
}

QFrame#panel_row QLabel#panel_dot
{
    color:          $text_dim;
    font-size:      8px;
}

QFrame#panel_row[enabled_item=true] QLabel#panel_dot
{
    color:          $enabled;
}

QFrame#panel_row QLabel#panel_name
{
    color:          $text_dim;
    font-size:      13px;
}

QFrame#panel_row[enabled_item=true] QLabel#panel_name
{
    color:          $text;
}

QFrame#panel_row QToolButton#ashlc
{
    background:     transparent;
    color:          $border;
    border:         none;
    border-radius:  2px;
    min-width:      18px;
    max-width:      18px;
    min-height:     18px;
    max-height:     18px;
    padding:        0px;
    font-size:      11px;
    font-weight:    bold;
}

QFrame#panel_row[enabled_item=true] QToolButton#ashlc
{
    background:     $button;
    color:          $text_bright;
}

QFrame#panel_row[all_row=true] QToolButton#ashlc
{
    color:          $text_bright;
}

QFrame#panel_row[all_row=true] QToolButton#ashlc[column="A"] { background: $all_a; }
QFrame#panel_row[all_row=true] QToolButton#ashlc[column="S"] { background: $all_s; }
QFrame#panel_row[all_row=true] QToolButton#ashlc[column="H"] { background: $all_h; }
QFrame#panel_row[all_row=true] QToolButton#ashlc[column="L"] { background: $all_l; }
QFrame#panel_row[all_row=true] QToolButton#ashlc[column="C"] { background: $all_c; }

QFrame#panel_row QToolButton#ashlc:hover
{
    color:          #ffffff;
}

QFrame#panel_row QToolButton#ashlc::menu-indicator
{
    image:          none;
    width:          0px;
}

QFrame#panel_row QToolButton#group_arrow
{
    background:     transparent;
    color:          $text_dim;
    border:         none;
    padding:        0px;
}

/* wizard panel and state bar (content panel, above the toggles) */

QFrame#wizard_panel
{
    background:     $window;
    border-top:     1px solid $border;
}

QLabel#wizard_title
{
    background:     $selection;
    color:          $text_bright;
    font-weight:    bold;
    padding:        3px 6px;
}

QPushButton#wizard_button
{
    padding:        3px 10px;
}

QToolButton#wizard_menu
{
    background:     $panel;
    color:          $text;
    border:         1px solid $border;
    border-radius:  2px;
    padding:        3px 20px;
}

QToolButton#wizard_menu:hover
{
    background:     $hover;
}

QToolButton#wizard_menu::menu-indicator
{
    image:          url($icons/chevron-down.svg);
    width:          10px;
    height:         10px;
    subcontrol-origin: padding;
    subcontrol-position: right center;
    right:          6px;
}

QFrame#state_bar
{
    background:     $window;
    border-top:     1px solid $border;
}

QFrame#state_bar QToolButton#state_button
{
    color:          $text;
    background:     transparent;
    border:         none;
    border-radius:  2px;
    min-width:      20px;
    padding:        2px;
}

QFrame#state_bar QToolButton#state_button:hover
{
    background:     $hover;
}

QFrame#state_bar QToolButton#state_button:checked
{
    background:     $base;
}

QLabel#state_label
{
    color:          $text_dim;
    padding-left:   6px;
    font-size:      12px;
}

/* toggle toolbar (bottom of the content panel), same look as the toolbar */

QToolBar#pymolx_toggles
{
    background:     $window;
    border:         none;
    border-top:     1px solid $border;
    padding:        0px;
    spacing:        0px;
}

QToolBar#pymolx_toggles::separator
{
    background:     $border;
    width:          1px;
    margin:         0px;
}

QToolBar#pymolx_toggles QToolButton
{
    color:          $text;
    background:     transparent;
    border:         none;
    border-radius:  0px;
    padding:        0px 5px;
    min-height:     30px;
    font-size:      12px;
    font-weight:    bold;
}

QToolBar#pymolx_toggles QToolButton:hover
{
    background:     $hover;
}

QToolBar#pymolx_toggles QToolButton:checked
{
    background:     $base;
    color:          $accent_text;
}

QToolBar#pymolx_toggles QToolButton::menu-button
{
    border:         none;
    border-left:    1px solid $border;
    background:     transparent;
    width:          16px;
}

QToolBar#pymolx_toggles QToolButton::menu-arrow
{
    image:          url($icons/chevron-up.svg);
    width:          10px;
    height:         10px;
}

QToolBar#pymolx_toggles QToolButton[split=true]
{
    padding-right:  21px;
}

/* no arrow on the Wizard button, like Incentive PyMOL */
QToolBar#pymolx_toggles QToolButton::menu-indicator
{
    image:          none;
    width:          0px;
}

/* output and command line */

QFrame#extgui
{
    background:     $base;
    border:         none;
}

QPlainTextEdit#feedback_browser
{
    background:     $base;
    color:          $text_bright;
    border:         none;
    padding-left:   8px;
    selection-background-color: $selection;
}

QLabel#command_label
{
    color:          $accent_text;
    font-size:      13px;
    font-weight:    bold;
    padding-left:   6px;
}

QLineEdit#command_line
{
    background:     $panel;
    color:          $text_bright;
    border:         none;
    border-radius:  0px;
    padding:        3px 4px;
    selection-background-color: $selection;
}

/* generic widgets */

QPushButton
{
    background:     $panel;
    color:          $text;
    border:         1px solid $border;
    border-radius:  2px;
    padding:        3px 10px;
}

QPushButton:hover
{
    background:     $hover;
}

QPushButton:pressed, QPushButton:checked
{
    background:     $base;
    color:          $accent_text;
}

QPushButton:disabled
{
    color:          $text_dim;
}

QToolTip
{
    background:     $menu;
    color:          $text;
    border:         1px solid $border;
}

QScrollBar:vertical
{
    background:     $base;
    width:          10px;
    margin:         0px;
}

QScrollBar::handle:vertical
{
    background:     $border;
    border-radius:  4px;
    min-height:     24px;
}

QScrollBar:horizontal
{
    background:     $base;
    height:         10px;
    margin:         0px;
}

QScrollBar::handle:horizontal
{
    background:     $border;
    border-radius:  4px;
    min-width:      24px;
}

QScrollBar::add-line, QScrollBar::sub-line
{
    width:          0px;
    height:         0px;
}

/* vi:ft=css:expandtab:sw=4
 */
